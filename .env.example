# Copyable environment variables for development. Do not include sensitive information here.

# [OPTIONAL] Server port (default: 5000)
# PORT=

# [REQUIRED] API key that callers send in the Authorization header. The app does not start without it.
SECRET_KEY=

# [OPTIONAL] Enable Flask debug mode for local development (default: false)
# FLASK_DEBUG=

# [OPTIONAL] CORS allowed origins for local development (default: http://localhost:3000)
# CORS_ALLOWED_ORIGINS=

# [OPTIONAL] The IATI.cloud endpoint that answers Solr select queries for the activity core
# (default: https://fcdo.iati.cloud/search/activity/). For a plain Solr core, include the handler: .../solr/<core>/select
# SOLR_URL=

# [OPTIONAL] Timeout in seconds for one Solr query (default: 10)
# SOLR_TIMEOUT=

# [OPTIONAL] Time budget in seconds for one /chain request; when it runs out the result is truncated (default: 30)
# REQUEST_TIMEOUT=

# [OPTIONAL] Maximum hops per walk; callers may lower it but not raise it (default: 20)
# MAX_DEPTH=

# [OPTIONAL] Maximum nodes per response; callers may lower it but not raise it (default: 1000)
# MAX_NODES=

# [OPTIONAL] Identifiers per Solr query, at most 250 (default: 200)
# ID_BATCH_SIZE=

# [OPTIONAL] Redis response cache; docker compose overrides this to point at its redis service
# (default: redis://localhost:6379/0)
# REDIS_URL=

# [OPTIONAL] Cache lifetime in seconds (default: 86400)
# CACHE_TTL=
