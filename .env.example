# Copyable environment variables for development. Do not include sensitive information here.

# [OPTIONAL] Server port (default: 5000)
# PORT=

# [OPTIONAL] Secret key (default: '')
# SECRET_KEY=

# [OPTIONAL] Enable Flask debug mode for local development (default: false)
# FLASK_DEBUG=

# [OPTIONAL] CORS allowed origins for local development (default: http://localhost:3000)
# CORS_ALLOWED_ORIGINS=
